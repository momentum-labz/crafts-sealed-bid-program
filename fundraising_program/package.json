{
  "type": "module",
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "anchor test --skip-local-validator",
    "test:surfpool": "anchor test --skip-local-validator",
    "test:stress": "cross-env RUN_STRESS_TESTS=true ts-mocha -p ./tsconfig.json -t 600000 tests/**/*.ts",
    "test:stress:1k": "cross-env RUN_STRESS_TESTS=true ts-mocha -p ./tsconfig.json -t 600000 tests/**/*.ts",
    "test:stress:5k": "cross-env RUN_STRESS_TESTS=true RUN_5K_TEST=true ts-mocha -p ./tsconfig.json -t 1800000 tests/**/*.ts"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "drand-client": "^1.4.2",
    "js-yaml": "^4.1.1",
    "nanoid": "^3.3.8",
    "tlock-js": "^0.9.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "cross-env": "^10.1.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
